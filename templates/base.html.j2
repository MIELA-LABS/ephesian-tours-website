<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site.brand_name }} | {{ site.descriptor }}</title>
  <meta name="description" content="{{ site.descriptor }}">
  {% if site.preview_mode %}
  <meta name="robots" content="noindex, nofollow">
  {% endif %}
  <link rel="canonical" href="{{ site.base_url }}">
</head>
<body>
  <main>
    <h1>{{ site.brand_name }}</h1>
    <p>{{ site.descriptor }}</p>
  </main>
</body>
</html>
