{% set s = sections.host %}
<section class="section section--host" id="about" aria-labelledby="host-title">
  <div class="container host reveal">
    <div class="host__photo">
      {% if host.photo.value %}
        {{ m.picture(host.photo.value, sizes="(min-width: 800px) 20rem, 60vw", cls="host__img") }}
      {% else %}
        <div class="host__placeholder" role="img" aria-label="Photo of {{ host.name }} coming soon">
          {{ m.mark("host__mark") }}
        </div>
      {% endif %}
      {{ m.badge(host.photo) }}
    </div>
    <div class="host__text">
      <p class="eyebrow">{{ s.eyebrow }}</p>
      <h2 id="host-title">{{ s.heading }}</h2>
      <p class="host__name">{{ host.name }}</p>
      <p class="host__role">{{ host.role }}</p>
      <p class="host__bio">{{ m.tracked(host.bio) }}</p>
    </div>
  </div>
</section>
