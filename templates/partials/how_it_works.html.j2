{% import "partials/_icons.html.j2" as ic %}
{% set s = sections.how_it_works %}
<section class="section section--how" id="how-it-works" aria-labelledby="how-title">
  <div class="container">
    <header class="section__header reveal">
      <p class="eyebrow">{{ s.eyebrow }}</p>
      <h2 id="how-title">{{ s.heading }}</h2>
      {% if s.intro %}<p class="section__intro">{{ s.intro }}</p>{% endif %}
    </header>
    <ol class="steps">
      {% for step in how_it_works.steps %}
      <li class="step reveal">
        <span class="step__icon">{{ ic.icon(step.icon, "step__svg") }}</span>
        <div class="step__body">
          <p class="step__n">Step {{ loop.index }}</p>
          <h3 class="step__title">{{ step.title }}</h3>
          <p>{{ step.body }}</p>
          {% if step.signature %}
          <p class="signature">{% if step.photo %}{{ m.avatar(step.photo) }}{% endif %}<span>— {{ step.signature }}</span></p>
          {% endif %}
          {% if step.sample and site.preview_mode %}
          <p class="step__status">{{ m.badge(step) }}{% if step.note %} <span>{{ step.note }}</span>{% endif %}</p>
          {% endif %}
        </div>
      </li>
      {% endfor %}
    </ol>
    <p class="callout reveal">{{ m.tracked(how_it_works.leader_note) }}</p>
  </div>
</section>
