{% set s = sections.booking %}
<section class="section section--booking" id="booking" aria-labelledby="booking-title">
  <div class="container">
    <header class="section__header reveal">
      <p class="eyebrow">{{ s.eyebrow }}</p>
      <h2 id="booking-title">{{ s.heading }}</h2>
      {% if s.intro %}<p class="section__intro">{{ s.intro }}</p>{% endif %}
    </header>
    <ol class="timeline reveal">
      {% for ms in booking.milestones %}
      <li class="timeline__item">
        <span class="timeline__dot" aria-hidden="true"></span>
        <h3 class="timeline__label">{{ ms.label }}</h3>
        <p class="timeline__when">{{ m.tracked(ms.when) }}</p>
        {% if ms.amount %}<p class="timeline__amount">{{ ms.amount.value }}</p>{% endif %}
        {% if ms.body %}<p class="timeline__body">{{ ms.body }}</p>{% endif %}
      </li>
      {% endfor %}
    </ol>
    <dl class="terms reveal">
      <div>
        <dt>Payment methods</dt>
        <dd>{{ booking.payment_methods.value }}</dd>
      </div>
      <div>
        <dt>Group size</dt>
        <dd>{{ booking.minimum_group }}</dd>
      </div>
      <div>
        <dt>Travel insurance</dt>
        <dd>{{ booking.insurance_note.value }}</dd>
      </div>
    </dl>
    <div class="cancel reveal">
      <h3 class="cancel__title">Cancellation policy</h3>
      <p class="cancel__intro">{{ booking.cancellation_intro }}</p>
      <table class="cancel__table">
        <thead><tr><th scope="col">When you cancel</th><th scope="col">What is refunded</th></tr></thead>
        <tbody>
          {% for row in booking.cancellation %}<tr><td>{{ row.when }}</td><td>{{ row.refund }}</td></tr>{% endfor %}
        </tbody>
      </table>
      <p class="callout callout--insurance">{{ booking.cancellation_note }}</p>
    </div>
  </div>
</section>
