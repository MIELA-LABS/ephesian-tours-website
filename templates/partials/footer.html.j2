<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <p class="brand brand--footer">{{ m.mark("brand__mark") }}<span class="brand__name">{{ site.brand_name }}</span></p>
      <p class="site-footer__descriptor">{{ site.descriptor }}</p>
      <p class="site-footer__partner">{{ site.partner_line }}</p>
      <p class="site-footer__verse">“{{ site.brand_line }}” <cite>{{ site.brand_line_ref }}</cite></p>
    </div>
    <nav class="site-footer__links" aria-label="Footer">
      <h2 class="site-footer__heading">Quick links</h2>
      <ul>
        {% for link in nav %}<li><a href="{{ link.href }}">{{ link.label }}</a></li>{% endfor %}
        <li><a href="#booking">Booking &amp; Payments</a></li>
      </ul>
    </nav>
    <div class="site-footer__contact">
      <h2 class="site-footer__heading">Contact</h2>
      <p><a href="mailto:{{ contact.email.value }}">{{ contact.email.value }}</a>{{ m.badge(contact.email) }}<br>
        {{ contact.phone.value }}{{ m.badge(contact.phone) }}<br>
        {{ contact.location }}</p>
    </div>
  </div>
  <div class="container site-footer__legal"><div class="site-footer__legal-inner">
    <p class="site-footer__operator">Land arrangements operated by {{ partner.name }}, {{ partner.location }} (TÜRSAB license no. {{ partner.license_no.value }}).</p>
    <details class="credits">
      <summary>Photo, map, and video credits</summary>
      <ul>
        {% for i in images if i.ready and i.author %}
        <li>{{ i.subject }}: {{ i.author }}, {% if i.source_url %}<a href="{{ i.source_url }}" target="_blank" rel="noopener">source</a>, {% endif %}{% if i.license_url %}<a href="{{ i.license_url }}" target="_blank" rel="noopener">{{ i.license }}</a>{% else %}{{ i.license }}{% endif %}</li>
        {% endfor %}
        {% for v in videos %}
        <li>{{ v.title }}: {{ v.author }}, <a href="{{ v.source_url }}" target="_blank" rel="noopener">Vimeo</a></li>
        {% endfor %}
        <li>Maps: © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors, via <a href="https://leafletjs.com" target="_blank" rel="noopener">Leaflet</a></li>
      </ul>
    </details>
    <p class="site-footer__notice">{{ site.scripture_notice }}</p>
    <p>© {{ build_year }} {{ site.brand_name }}. All rights reserved.</p>
  </div></div>
</footer>
